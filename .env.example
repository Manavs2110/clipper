# Create an app at https://dev.twitch.tv/console/apps (OAuth redirect: http://localhost)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional overrides
GAME_NAME=Grand Theft Auto VI
WHISPER_MODEL=small
FONT_PATH=/System/Library/Fonts/Supplemental/Impact.ttf
BEEP_PROFANITY=true   # false = only beep slurs
ALLOW_BLURRED_NUDITY=false   # true = blur nudity and allow posting (risky)
